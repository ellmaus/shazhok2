{
  "name": "shazhok",
  "version": "0.1.0",
  "private": true,
  "description": "Шажок — Telegram-бот + Mini App: помощник по бытовым делам без перегруза",
  "workspaces": [
    "bot",
    "webapp"
  ],
  "scripts": {
    "dev": "concurrently -n bot,web -c blue,magenta \"npm:dev:bot\" \"npm:dev:web\"",
    "dev:bot": "npm run dev -w bot",
    "dev:web": "npm run dev -w webapp",
    "build": "npm run build -w webapp",
    "typecheck": "npm run typecheck -w bot && npm run typecheck -w webapp",
    "start": "npm run start -w bot"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0"
  }
}
